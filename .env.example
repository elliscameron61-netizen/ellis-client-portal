# Local Postgres. See docker-compose.yml.
DATABASE_URL="postgresql://ellis:ellis@localhost:5432/ellis_portal?schema=public"

# Used by automated tests. Create this database before running npm test.
TEST_DATABASE_URL="postgresql://ellis:ellis@localhost:5432/ellis_portal_test?schema=public"

# Public URL of this portal. Used in emails and sign-in links.
APP_URL="http://localhost:3000"

# From address when SMTP is configured.
EMAIL_FROM="Ellis Electrical <info@elliselectrical.co.za>"

# Optional extra recipient for fault notifications (in addition to every active Ellis admin).
# NOTIFY_EMAIL="info@elliselectrical.co.za"

# Optional SMTP. When unset, messages are stored and visible under Admin → Messages.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""

# Development only. When true (and NODE_ENV is not production), sign-in and
# password links are shown on screen and in the message log. Ignored in production.
SHOW_DEV_LINKS="true"

# Used only by prisma/seed.ts. Change these before any shared or production deployment.
SEED_ADMIN_PASSWORD="Example-Admin-2026!"
SEED_CLIENT_PASSWORD="Example-Client-2026!"
