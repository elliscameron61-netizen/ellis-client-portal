generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum FaultPriority {
  LOW
  NORMAL
  HIGH
}

enum FaultStatus {
  NEW
  ACKNOWLEDGED
  CLOSED
}

enum AttachmentKind {
  PHOTO
  DOCUMENT
  COC
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String
  passwordHash   String?
  role           Role
  organisationId String?
  organisation   Organisation?  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  disabled       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  lastLoginAt    DateTime?
  sessions       Session[]
  authTokens     AuthToken[]
  faultRequests  FaultRequest[]

  @@index([organisationId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

model Organisation {
  id            String         @id @default(cuid())
  name          String         @unique
  portalEnabled Boolean        @default(false)
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  notes         String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  sites         Site[]
  jobs          Job[]
  invoices      Invoice[]
  certificates  Certificate[]
  faultRequests FaultRequest[]
  attachments   Attachment[]
}

model Site {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  address        String
  contactName    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  jobs           Job[]
  certificates   Certificate[]
  faultRequests  FaultRequest[]

  @@unique([organisationId, name])
  @@index([organisationId])
}

model Job {
  id             String        @id @default(cuid())
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  siteId         String?
  site           Site?         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  externalRef    String?
  importKey      String?
  title          String
  description    String?       @db.Text
  status         String
  scheduledAt    DateTime?
  completedAt    DateTime?
  team           String?
  source         String        @default("manual")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  notes          JobNote[]
  attachments    Attachment[]
  resources      JobResource[]
  certificates   Certificate[]

  @@unique([organisationId, externalRef])
  @@unique([organisationId, importKey])
  @@index([organisationId])
  @@index([siteId])
}

model JobNote {
  id         String   @id @default(cuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  body       String   @db.Text
  authorName String
  visibility String   @default("client")
  createdAt  DateTime @default(now())

  @@index([jobId])
}

model JobResource {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String?  @db.Text
  url       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([jobId])
}

model Certificate {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  siteId         String?
  site           Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  jobId          String?
  job            Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  type           String       @default("COC")
  number         String?
  title          String
  issuedAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  attachments    Attachment[]

  @@index([organisationId])
  @@index([siteId])
}

model Invoice {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  jobId          String?
  externalRef    String
  jobNumber      String?
  customerName   String?
  description    String?
  status         String
  issuedAt       DateTime?
  dueAt          DateTime?
  totalCents     Int
  balanceCents   Int
  currency       String       @default("ZAR")
  source         String       @default("quickbooks")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, externalRef])
  @@index([organisationId])
}

model FaultRequest {
  id             String        @id @default(cuid())
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  siteId         String
  site           Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  description    String        @db.Text
  priority       FaultPriority
  status         FaultStatus   @default(NEW)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  attachments    Attachment[]

  @@index([organisationId])
  @@index([status])
}

model Attachment {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  jobId          String?
  job            Job?           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  certificateId  String?
  certificate    Certificate?   @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  faultRequestId String?
  faultRequest   FaultRequest?  @relation(fields: [faultRequestId], references: [id], onDelete: Cascade)
  filename       String
  mimeType       String
  storageKey     String
  kind           AttachmentKind
  sizeBytes      Int
  createdAt      DateTime       @default(now())

  @@index([organisationId])
  @@index([jobId])
  @@index([storageKey])
}

model StoredObject {
  id        String   @id @default(cuid())
  key       String   @unique
  data      Bytes
  createdAt DateTime @default(now())
}

model EmailMessage {
  id        String   @id @default(cuid())
  toAddress String
  subject   String
  body      String   @db.Text
  channel   String   @default("email")
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
